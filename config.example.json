{
  "fqdn": "YOUR_FQDN",
  "key_id": "YOUR_KEY_ID",
  "api_key": "YOUR_STANDARD_API_KEY",
  "page_size": 100,
  "output": "issues.csv",
  "retry_count": 5,
  "timeout": 60,
  "gzip": false,
  "api_filters": [
    {
      "field": "category",
      "operator": "in",
      "value": [
        "CONFIGURATION"
      ]
    },
    {
      "field": "severity",
      "operator": "in",
      "value": [
        "CRITICAL"
      ]
    }
  ]
}
